# Copy this file to .env and fill in real values.
# Only variables prefixed with VITE_ are exposed to the client bundle —
# never put secrets here, they are publicly visible in the built app.

# ── App ────────────────────────────────────────────────────────────────
VITE_APP_NAME=

# ── API origin ───────────────────────────────────────────────────────────
# Set this to the root URL of your backend. The browser always calls
# same-origin /api/**; Vite (local) and the Vercel proxy forward requests to
# this URL, so no backend CORS change is required.
VITE_API_BASE_URL=
VITE_REQUEST_TIMEOUT=
